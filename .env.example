# Copy to .env and fill in. Never commit the real file.

# --- Backend (set these as the Modal secret "rulecollision") ---
DATABASE_URL=postgresql://user:password@host/dbname
JWT_SECRET=use-a-long-random-string-of-at-least-32-characters
AGENT_API_KEY=use-another-long-random-string
WEB_APP_URL=https://your-frontend.pages.dev
CORS_ORIGINS=https://your-frontend.pages.dev
DEMO_PASSWORD=choose-a-demo-password
SEED_DEMO=1

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=rulecollision

GROQ_API_KEY=
OPENAI_API_KEY=

R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rulecollision

# --- Agent (set these as LiveKit Cloud secrets) ---
BACKEND_URL=https://your-workspace--rulecollision-backend-api.modal.run
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
# plus AGENT_API_KEY, GROQ_API_KEY, OPENAI_API_KEY, LIVEKIT_* from above

# --- Frontend (build-time) ---
VITE_API_URL=https://your-workspace--rulecollision-backend-api.modal.run

# --- GitHub secrets used only by the Deploy workflow ---
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
